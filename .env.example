# ============================================
# SERVIDOR
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# BANCO DE DADOS
# ============================================
# Postgres (Supabase). Troque pelos seus dados reais no .env.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO"

# ============================================
# AUTENTICAÇÃO (JWT)
# ============================================
# Segredo OBRIGATÓRIO, mínimo 32 caracteres aleatórios (a API não sobe sem isso).
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use um segredo DIFERENTE em produção e nunca o coloque neste arquivo.
JWT_SECRET="troque-este-segredo"

# Validade do token (ex.: 15m, 1h, 7d). Padrão: 1h
JWT_EXPIRES_IN="1h"

# ============================================
# CORS
# ============================================
# Origens do front autorizadas, separadas por vírgula.
# Sem esta variável, em desenvolvimento libera http://localhost:5173 e :3000;
# em produção não libera nenhuma.
CORS_ORIGINS="http://localhost:5173"

# Atrás de proxy/load balancer (Render, Railway, Nginx...): "true" ou o número
# de proxies. Sem isso o rate limit enxerga o IP do proxy e limita todo mundo junto.
TRUST_PROXY="false"

# ============================================
# DOCUMENTAÇÃO E LOGS
# ============================================
# /api-docs fica ligado fora de produção. Em produção, só com ENABLE_DOCS="true".
# ENABLE_DOCS="false"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# ============================================
# UPLOADS
# ============================================
UPLOAD_DIR="./uploads"

# ============================================
# SEED (somente desenvolvimento)
# ============================================
# Senha do cliente demo criado por `npm run prisma:seed`. Padrão: 123456
# O seed se recusa a rodar com NODE_ENV=production.
# SEED_DEMO_PASSWORD="123456"
