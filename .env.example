# ============================================
# SERVIDOR
# ============================================
# Porta do servidor
PORT=3000

# Host do servidor
HOST=0.0.0.0

# Ambiente (development, production, test)
NODE_ENV=development

# ============================================
# UPLOADS
# ============================================
# Diretório para armazenar imagens
UPLOAD_DIR="./uploads"

# ============================================
# BANCO DE DADOS
# ============================================
# Connection string do banco PostgreSQL
# Formato sugerido (Postgres):
# postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="database url"


# ============================================
# AUTENTICAÇÃO (JWT)
# ============================================
# Segredo OBRIGATÓRIO, mínimo 32 caracteres aleatórios (a API não sobe sem isso).
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use um segredo DIFERENTE em produção.
JWT_SECRET="troque-este-segredo"

# Validade do token (ex.: 15m, 1h, 7d). Padrão: 1h
JWT_EXPIRES_IN="1h"

# ============================================
# CORS
# ============================================
# Origens do front autorizadas, separadas por vírgula.
# Sem esta variável, em desenvolvimento libera http://localhost:5173 e :3000;
# em produção não libera nenhuma.
CORS_ORIGINS="http://localhost:5173"
